@startuml filtrado-cliente-identificado

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #1E50A0
skinparam ArrowThickness 1.5

skinparam activity {
  BackgroundColor #E8EEF8
  BorderColor #1E50A0
  FontColor #111111
  DiamondBackgroundColor #FFF3CD
  DiamondBorderColor #C07000
  DiamondFontColor #111111
  StartColor #1E50A0
  EndColor #2E7D32
}

skinparam note {
  BackgroundColor #F5F7FF
  BorderColor #99AACC
  FontSize 10
}

title Cliente identificado en BD\n//extensión del flujo principal//

start

#D4EDDA:BD: match por CURP\n→ fallback nombre + teléfono;
note right
  Si hay duplicados (misma CURP):
  usar el registro con
  created_at más temprano
end note

#D4EDDA:c12 = "si"\npersona_id cliente asignado;

#E8EEF8:GET /api/filtrado-clientes\n     /historial/{persona_id};
note right
  Devuelve:
  · score_final
  · lista de préstamos
  · acumulado puntual
end note

' ── c22: NIVEL ───────────────────────────────
partition "**c22 — Nivel válido por scores**" {
  if (¿Nivel de la solicitud\ncorresponde al historial?) then (NO)
    #FDDCDC:c22 = false\n+ hallazgo: nivel inválido;
    note right
      NUEVO = sin historial
      NOBEL = 1 crédito + score ≥ 80
      VIP   = 2 créditos
      PREMIUM = 3 créditos
      LEAL  = 4 créditos
      DIAMANTE = 4 + acum ≥ $50,000
    end note
  else (SÍ)
    #D4EDDA:c22 = true;
  endif
}

' ── c25: SCORE ───────────────────────────────
partition "**c25 — Score cliente aceptable**" {
  if (¿score_final cumple\npara el nivel solicitado?) then (NO)
    #FDDCDC:c25 = "no"\n+ hallazgo: score insuficiente;
  else (SÍ)
    #D4EDDA:c25 = "si";
  endif
}

' ── c21: AUMENTO ─────────────────────────────
partition "**c21 — Aumento máximo $2,000**" {
  if (¿monto actual − monto\núltimo préstamo > $2,000?) then (SÍ)
    #FDDCDC:c21 = false\n+ hallazgo: aumento excede $2,000;
  else (NO)
    #D4EDDA:c21 = true;
  endif
}

' ── c24: ÚLTIMA SEMANA ───────────────────────
partition "**c24 — Última semana respetada**" {
  if (¿semana solicitud respeta\ncierre del último crédito?) then (NO)
    #FDDCDC:c24 = false\n+ hallazgo: semana no respetada;
  else (SÍ)
    #D4EDDA:c24 = true;
  endif
}

' ── c26: LIQ ESPECIAL CLIENTE ────────────────
partition "**c26 — Cliente sin liquidación especial**" {
  #E8EEF8:MCP liquidaciones\nSELECT * WHERE persona_id = cliente\nAND tipo_liquidacion = 'especial';
  if (¿tiene liquidación especial\nen historial previo?) then (SÍ)
    #FDDCDC:c26 = "no"\n+ hallazgo: liq. especial detectada;
  else (NO)
    #D4EDDA:c26 = "si";
  endif
}

' ── c23: NO LIQ + SUBE ───────────────────────
partition "**c23 — No liquidó con descuento y sube nivel**" {
  if (¿c26 = "no" Y el nivel\nsolicitado es mayor al anterior?) then (SÍ)
    #FDDCDC:c23 = "no"\n+ hallazgo: liquidó con descuento y sube;
  else (NO)
    #D4EDDA:c23 = "si" o "no_aplica";
  endif
}

#D4EDDA:Checks cliente resueltos\nRegresar al flujo principal;

stop

@enduml
