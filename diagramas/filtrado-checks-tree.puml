@startuml filtrado-checks-tree

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #1E50A0

skinparam activity {
  BackgroundColor #E8EEF8
  BorderColor #1E50A0
  FontColor #111111
  DiamondBackgroundColor #FFF3CD
  DiamondBorderColor #C07000
  DiamondFontColor #111111
  StartColor #1E50A0
  EndColor #B03020
}

skinparam note {
  BackgroundColor #F5F7FF
  BorderColor #99AACC
  FontSize 10
}

title Árbol de Decisión — Checks → Resultado Final\n//Todos los checks se evalúan siempre, aunque ya haya un bloqueo//

start

:Todos los checks resueltos\n//set completo acumulado en pasos 2–4//;

note right
  Se acumula una lista de hallazgos.
  El proceso NO se detiene al primer
  bloqueo — se evalúan todos los grupos.
end note

' =====================
' GRUPO 1: IDENTIDAD
' =====================
partition "**Grupo 1 — Identidad (OCR)**" {
  if (c08 o c09 = false?\n//nombre capturado ≠ INE//) then (sí)
    #FDDCDC:+ hallazgo: nombre no coincide\n//c08 cliente · c09 aval//;
  else (no)
  endif

  if (c10 o c11 = false?\n//CURP capturada ≠ INE//) then (sí)
    #FDDCDC:+ hallazgo: CURP inválida\n//c10 cliente · c11 aval//;
  else (no)
  endif
}

' =====================
' GRUPO 2: DOMICILIO COMPARTIDO
' =====================
partition "**Grupo 2 — Domicilio compartido**" {
  if (r01 = false?\n//cliente y aval mismo domicilio//) then (sí)
    #FDDCDC:+ hallazgo: domicilio compartido;
  else (no)
  endif
}

' =====================
' GRUPO 3: HISTORIAL AVAL
' =====================
partition "**Grupo 3 — Historial del aval**" {
  if (aval es persona_nueva?) then (sí)
    #FFF3CD:c14·c15·c16·c17 = "persona_nueva"\n//skip — sin historial que evaluar//;
  else (no — aval existe en BD)
    if (c14 = "no"?\n//aval fue cliente moroso//) then (sí)
      #FDDCDC:+ hallazgo: aval moroso como cliente;
    else (no)
    endif
    if (c15 = "no"?\n//aval avaló cliente moroso//) then (sí)
      #FDDCDC:+ hallazgo: aval avaló a moroso;
    else (no)
    endif
    if (c16 = "no"?\n//aval tiene liq. especial como avalado//) then (sí)
      #FDDCDC:+ hallazgo: aval con liquidación especial;
    else (no)
    endif
    if (c17 = "no"?\n//aval activo en otra agencia//) then (sí)
      #FDDCDC:+ hallazgo: aval activo en otra agencia;
    else (no)
    endif
  endif
}

' =====================
' GRUPO 4: DOMICILIO SERVICIO
' =====================
partition "**Grupo 4 — Domicilio (no_servicio)**" {
  if (c18/c19/c20 disponibles?\n//se obtuvo no_servicio corregido//) then (sí)
    if (c18 = false?\n//más de 3 clientes activos//) then (sí)
      #FDDCDC:+ hallazgo: domicilio excede 3 clientes;
    else (no)
    endif
    if (c19 = false?\n//saldo + monto nuevo > límite//) then (sí)
      #FDDCDC:+ hallazgo: domicilio excede monto máximo;
    else (no)
    endif
    if (c20 = false?\n//gerencias distintas en domicilio//) then (sí)
      #FDDCDC:+ hallazgo: domicilio cruza agencia;
    else (no)
    endif
  else (no — no_servicio no corregido)
    #FFF3CD:c18·c19·c20 = null\n//no bloquean por sí solos//;
  endif
}

' =====================
' GRUPO 5: NIVEL Y MONTO
' =====================
partition "**Grupo 5 — Nivel y monto**" {
  if (cliente es persona_nueva\ny nivel = NUEVO?) then (sí)
    #FFF3CD:c21·c22·c24 → no aplican restricciones\nde historial previo;
  else (no — cliente con historial)
    if (c21 = false?\n//aumento > $2,000//) then (sí)
      #FDDCDC:+ hallazgo: aumento excede $2,000;
    else (no)
    endif
    if (c22 = false?\n//nivel no corresponde a historial//) then (sí)
      #FDDCDC:+ hallazgo: nivel inválido por scores;
    else (no)
    endif
  endif
}

' =====================
' DECISION FINAL
' =====================
if (¿Lista de hallazgos tiene\nal menos un bloqueante?) then (sí)
  #FDDCDC:**status_filtrado = "requiere_correccion"**\nstatus → en_correccion\npaso_actual → filtrado;
  note right
    diagnostico: descripción de TODOS
    los hallazgos encontrados
    motivo_rechazo: razón principal
    doc_invalido_detalle: si aplica
  end note
else (no — lista vacía)
  #D4EDDA:**status_filtrado = "sin_hallazgos"**\nstatus → en_vistos_buenos\npaso_actual → vistos_buenos;
  note right
    diagnostico: descripción del caso
    motivo_rechazo: "no_aplica"
    doc_invalido_detalle: "no_aplica"
  end note
endif

stop

@enduml
